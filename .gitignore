# Python files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv
# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.Python

# ---------------------------------------------------------------------------
# Environments
# ---------------------------------------------------------------------------
.venv/
venv/
.env                  # Real secrets. NEVER committed.
!.env.example         # The template IS committed — it documents required vars.

# ---------------------------------------------------------------------------
# Tooling caches
# ---------------------------------------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# ---------------------------------------------------------------------------
# Data
# ---------------------------------------------------------------------------
# Ignore all data by default, then re-allow the published output.
# The scheduled workflow commits data/output/ — it IS the deliverable.
data/*
!data/output/
!data/output/.gitkeep
data/output/*.tmp     # Atomic-write staging files never get committed

# ---------------------------------------------------------------------------
# Editors / OS
# ---------------------------------------------------------------------------
.vscode/
.idea/
Thumbs.db
desktop.ini